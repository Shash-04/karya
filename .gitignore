# ─────────────────────────────────────────────────────────────
# TaskForge — root .gitignore
# ─────────────────────────────────────────────────────────────

# Environment / secrets
.env
.env.*
!.env.example

# PRD / working docs (not part of the codebase)
*.md.md
*.md.docx
TaskForge-PRD-*

# ── Java / Spring Boot / Maven / Gradle (server/) ─────────────
server/target/
**/target/
server/build/
server/.gradle/
server/out/
server/bin/
**/*.class
**/*.jar
!**/gradle/wrapper/gradle-wrapper.jar
**/*.war
**/*.log
hs_err_pid*
server/uploads/

# ── Node / Next.js (client/) ──────────────────────────────────
client/node_modules/
client/.next/
client/out/
client/build/
client/.turbo/
client/coverage/
client/next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── IDE / Editor ──────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Docker / local volumes ────────────────────────────────────
pgdata/
redis-data/

# Claude Code local config
.claude/
