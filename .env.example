# ─────────────────────────────────────────────────────────────
# TaskForge — environment variables (example)
# Copy to .env and fill in real values:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Postgres ──────────────────────────────────────────────────
POSTGRES_DB=taskforge
POSTGRES_USER=taskforge
POSTGRES_PASSWORD=change_me
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/taskforge
SPRING_DATASOURCE_USERNAME=taskforge
SPRING_DATASOURCE_PASSWORD=change_me

# ── Redis (queue + cache + sessions) ──────────────────────────
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
# Set true for managed Redis that requires TLS (Upstash, Redis Cloud).
SPRING_DATA_REDIS_SSL_ENABLED=false

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRY=900000          # 15 minutes (ms)
JWT_REFRESH_EXPIRY=604800000      # 7 days (ms)

# ── Queue ─────────────────────────────────────────────────────
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_DELAY=5000            # ms between retries
QUEUE_POLL_INTERVAL=30000        # ms between queue ticks (raise to cut Redis command usage)

# ── File upload ───────────────────────────────────────────────
UPLOAD_PATH=/app/uploads
MAX_FILE_SIZE=10MB

# ── App ───────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Client ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
